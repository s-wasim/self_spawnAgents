# AAE V3.0 environment variables (see §21 Day-0 operator checklist)

AAE_MODE=simulation
AAE_OPERATOR_EMAIL=operator@example.com

# Database
POSTGRES_DSN=postgresql+psycopg://aae:aae@aae-postgres:5432/aae
REDIS_URL=redis://aae-redis:6379/0

# Anthropic / Google
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Channels
POLAR_ORG_TOKEN=
LEMONSQUEEZY_API_KEY=
STRIPE_SECRET_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=
VERCEL_PAT=
VERCEL_PLAN=pro
NETLIFY_PAT=

# Gmail
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GCP_PUBSUB_TOPIC=projects/aae/topics/gmail-inbox

# Operator HMAC secret (32 bytes urlsafe) - signs EMERGENCY_TRANSFER
OPERATOR_HMAC_SECRET=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
